{
  "name": "@macrulez/inview-nuxt",
  "version": "0.2.2",
  "description": "Nuxt module wrapping @macrulez/inview-vue: auto-imported composables/core engines, a globally registered v-reveal directive, client-only guard, module options for default thresholds/once",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/module.js",
  "module": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "nuxt": "^3.9.0 || ^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@macrulez/inview-vue": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.5.2",
    "nuxt": "^4.5.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
